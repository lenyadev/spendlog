# окружение и секреты
# Исключаем env-файлы на ЛЮБОЙ глубине, но оставляем шаблон
**/.env
**/.env.*
!**/.env.example

# Виртуальные окружения (на любой глубине)
**/.venv/
**/venv/

# git и CI 
.git
.github

# Python-кэши и артефакты 
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.ruff_cache/

# тесты 
tests/

# редакторы и ОС 
.vscode/
.idea/
**/.DS_Store

# docker-файлы не нужны внутри образа 
Dockerfile
docker-compose.yml
.dockerignore