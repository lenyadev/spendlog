{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "gen:api": "openapi-typescript http://localhost:8000/openapi.json -o src/lib/api/schema.d.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "bun run format:check && bun run lint && bun run check"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tsconfig/svelte": "^5.0.9",
    "@types/node": "^26.6.6",
    "@vitejs/devtools": "^0.8.3",
    "@vitejs/devtools-rolldown": "^0.8.3",
    "@vitejs/devtools-vite": "^0.8.3",
    "eslint": "^10.16.0",
    "eslint-config-prettier": "^10.1.9",
    "eslint-plugin-svelte": "^3.24.1",
    "globals": "^17.14.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.10.1",
    "prettier-plugin-svelte": "^4.2.0",
    "svelte": "^5.59.1",
    "svelte-check": "^4.7.8",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.4.0"
  },
  "dependencies": {
    "sv-router": "^0.19.0"
  }
}
